<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Správa uživatelů — MysDB</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<%- include('../partials/navbar') %>

<div class="container">
  <div class="page-header flex-between">
    <div>
      <h1>Správa uživatelů</h1>
      <p><%= users.length %> registrovaných uživatelů</p>
    </div>
  </div>

  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th>Uživatel</th>
          <th>Role</th>
          <th>Akce</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(oneUser => { %>
          <tr>
            <td>
              <div style="font-weight:600;font-family:'Syne',sans-serif"><%= oneUser.username %></div>
            </td>
            <td>
              <% if (oneUser.role === 'admin') { %>
                <span class="badge badge-orange">admin</span>
              <% } else { %>
                <span class="badge badge-gray">user</span>
              <% } %>
            </td>
            <td>
              <form action="/admin/users/<%= oneUser._id %>/role" method="POST" style="display:flex;gap:0.5rem;align-items:center;">
                <select name="role" class="form-control" style="width:auto;padding:0.4rem 2rem 0.4rem 0.7rem;font-size:0.8rem;">
                  <option value="user" <%= oneUser.role === 'user' ? 'selected' : '' %>>user</option>
                  <option value="admin" <%= oneUser.role === 'admin' ? 'selected' : '' %>>admin</option>
                </select>
                <button type="submit" class="btn btn-secondary btn-sm">Uložit</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
</body>
</html>
