<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Registrace — MysDB</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="auth-wrapper">
  <div class="auth-card">
    <div class="auth-logo">
      <span style="width:8px;height:8px;background:var(--accent);border-radius:50%;display:inline-block;"></span>
      MysDB
    </div>
    <div class="auth-title">Registrace</div>
    <p class="auth-sub">Vytvoř si účet a začni spravovat databázi myší.</p>
    <form action="/register" method="POST">
      <div class="form-group">
        <label class="form-label">Uživatelské jméno</label>
        <input class="form-control" type="text" name="username" placeholder="jnovak" required autofocus>
      </div>
      <div class="form-group">
        <label class="form-label">Heslo</label>
        <input class="form-control" type="password" name="password" placeholder="••••••••" required>
      </div>
      <button type="submit" class="btn btn-primary btn-full" style="margin-top:0.5rem">Vytvořit účet</button>
    </form>
    <div class="auth-footer">
      Už máš účet? <a href="/login">Přihlás se</a>
    </div>
  </div>
</div>
</body>
</html>