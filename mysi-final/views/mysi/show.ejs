<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= mys.name %> — MysDB</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<%- include('../partials/navbar') %>

<div class="container">
  <a href="/mysi" class="back-link">← Zpět na seznam</a>

  <div class="detail-layout">
    <div>
      <% if (mys.image) { %>
        <img class="card-image" src="<%= mys.image %>" alt="<%= mys.name %>">
      <% } else { %>
        <div class="detail-image-placeholder">🖱️</div>
      <% } %>
    </div>

    <div class="detail-info">
      <div>
        <div class="detail-title"><%= mys.name %></div>
        <% if (mys.description) { %>
          <p class="detail-desc mt-1"><%= mys.description %></p>
        <% } %>
      </div>

      <div class="detail-props">
        <div class="prop-row">
          <span class="prop-label">Typ</span>
          <span class="badge badge-orange"><%= mys.typ %></span>
        </div>
        <div class="prop-row">
          <span class="prop-label">Kategorie</span>
          <span class="badge badge-gray"><%= mys.kategorie %></span>
        </div>
        <div class="prop-row">
          <span class="prop-label">Přidáno</span>
          <span class="prop-value"><%= new Date(mys.createdAt).toLocaleDateString('cs-CZ') %></span>
        </div>
      </div>

    <% if (user && (user.role === 'admin' || user.id == mys.autor?.toString())) { %>
      <a href="/mysi/<%= mys._id %>/upravit" class="btn btn-primary">Upravit</a>
      <form action="/mysi/<%= mys._id %>?_method=DELETE" method="POST">
        <button type="submit" class="btn btn-danger">Smazat</button>
      </form>
    <% } %>
    </div>
  </div>

  <div class="sep"></div>

  <div class="section-title">Zájem o tuto myš</div>
  <div style="max-width:520px">
    <div class="form-card">
      <form action="/zadosti/<%= mys._id %>" method="POST">
        <div class="form-group">
          <label class="form-label">Vaše jméno</label>
          <input class="form-control" type="text" name="jmenoZadatele" placeholder="Jan Novák" required>
        </div>
        <div class="form-group">
          <label class="form-label">E-mail</label>
          <input class="form-control" type="email" name="email" placeholder="jan@email.cz" required>
        </div>
        <div class="form-group">
          <label class="form-label">Proč chcete tuto myš?</label>
          <textarea class="form-control" name="zprava" placeholder="Napište pár slov..." required></textarea>
        </div>
        <button type="submit" class="btn btn-primary btn-full">Odeslat žádost</button>
      </form>
    </div>
  </div>
</div>
</body>
</html>

