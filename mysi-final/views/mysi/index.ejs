<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MysDB — Přehled myší</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<%- include('../partials/navbar') %>

<div class="container">
  <div class="page-header flex-between">
    <div>
      <h1>Evidence myší</h1>
      <p><%= mysi.length %> myší v databázi</p>
    </div>
  </div>

  <% if (mysi.length === 0) { %>
    <div class="empty-state">
      <div class="empty-icon">🖱️</div>
      <h3>Zatím žádné myši</h3>
      <p>Začni přidáním první myši do databáze.</p>
      <% if (user) { %>
        <a href="/mysi/pridat" class="btn btn-primary mt-2">+ Přidat myš</a>
      <% } %>
    </div>
  <% } else { %>
    <div class="grid">
      <% mysi.forEach(mys => { %>
        <a href="/mysi/<%= mys._id %>" class="card">
          <% if (mys.image) { %>
            <img class="card-image" src="/uploads/<%= mys.image %>" alt="<%= mys.name %>">
          <% } else { %>
            <div class="card-image-placeholder">🖱️</div>
          <% } %>
          <div class="card-body">
            <div class="card-title"><%= mys.name %></div>
            <div class="card-meta">
              <span class="badge badge-orange"><%= mys.typ %></span>
              <span class="badge badge-gray"><%= mys.age %> měs.</span>
            </div>
          </div>
        </a>
      <% }) %>
    </div>
  <% } %>
</div>
</body>
</html>