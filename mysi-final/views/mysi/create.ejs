<h1>Přidat myš</h1>
<form action="/mysi" method="POST" enctype="multipart/form-data">
  <input type="text" name="name" placeholder="Jméno myši" required>
  <br><br>
  <input type="text" name="breed" placeholder="Plemeno" required>
  <br><br>
  <input type="number" name="age" placeholder="Věk (měsíce)" required>
  <br><br>
  <textarea name="description" placeholder="Popis" required></textarea>
  <br><br>
  <input type="file" name="image">
  <br><br>
  <button type="submit">Uložit</button>
</form>
<p><a href="/mysi">Zpět</a></p>
