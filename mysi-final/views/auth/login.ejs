<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Přihlášení — MysDB</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="auth-wrapper">
  <div class="auth-card">
    <div class="auth-logo">
      <span style="width:8px;height:8px;background:var(--accent);border-radius:50%;display:inline-block;"></span>
      MysDB
    </div>
    <div class="auth-title">Přihlášení</div>
    <p class="auth-sub">Zadej své přihlašovací údaje pro přístup do systému.</p>
    <form action="/login" method="POST">
      <div class="form-group">
        <label class="form-label">Uživatelské jméno</label>
        <input class="form-control" type="text" name="username" placeholder="jnovak" required autofocus>
      </div>
      <div class="form-group">
        <label class="form-label">Heslo</label>
        <input class="form-control" type="password" name="password" placeholder="••••••••" required>
      </div>
      <button type="submit" class="btn btn-primary btn-full" style="margin-top:0.5rem">Přihlásit se</button>
    </form>
    <div class="auth-footer">
      Nemáš účet? <a href="/register">Zaregistruj se</a>
    </div>
  </div>
</div>
</body>
</html>
