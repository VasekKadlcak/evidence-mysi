<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Upravit <%= mys.name %> — MysDB</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<%- include('../partials/navbar') %>

<div class="container-sm">
  <a href="/mysi/<%= mys._id %>" class="back-link">← Zpět na detail</a>
  <div class="form-card">
    <div class="form-title">Upravit myš</div>
    <form action="/mysi/<%= mys._id %>?_method=PUT" method="POST" enctype="multipart/form-data">
      <div class="form-group">
        <label class="form-label">Jméno myši</label>
        <input class="form-control" type="text" name="name" value="<%= mys.name %>" required>
      </div>
      <div class="form-group">
        <label class="form-label">Typ</label>
        <input class="form-control" type="text" name="typ" value="<%= mys.typ %>" required>
      </div>
      <div class="form-group">
        <label class="form-label">Věk (měsíce)</label>
        <input class="form-control" type="number" name="age" value="<%= mys.age %>" min="0" required>
      </div>
      <div class="form-group">
        <label class="form-label">Popis</label>
        <textarea class="form-control" name="description" required><%= mys.description %></textarea>
      </div>
      <div class="form-group">
        <label class="form-label">Nová fotografie <span class="text-muted text-sm">(ponech prázdné pro zachování stávající)</span></label>
        <% if (mys.image) { %>
          <img src="/uploads/<%= mys.image %>" style="width:100%;border-radius:var(--radius-sm);margin-bottom:0.75rem;border:1px solid var(--border);">
        <% } %>
        <input class="form-control form-control-file" type="file" name="image" accept="image/*">
      </div>
      <div class="action-row">
        <button type="submit" class="btn btn-primary">Uložit změny</button>
        <a href="/mysi/<%= mys._id %>" class="btn btn-secondary">Zrušit</a>
      </div>
    </form>
  </div>
</div>
</body>
</html>