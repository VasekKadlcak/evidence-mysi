<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Přidat myš — MysDB</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<%- include('../partials/navbar') %>

<div class="container-sm">
  <a href="/mysi" class="back-link">← Zpět na seznam</a>
  <div class="form-card">
    <div class="form-title">Přidat novou myš</div>
    <form action="/mysi" method="POST" enctype="multipart/form-data">
      <div class="form-group">
        <label class="form-label">Jméno myši</label>
        <input class="form-control" type="text" name="name" placeholder="Logitech MX Master 3" required>
      </div>
      <div class="form-group">
        <label class="form-label">Typ</label>
          <select class="form-control" name="typ" required>
            <option value="">-- Vyber typ --</option>
            <option value="drátová">Drátová</option>
            <option value="bezdrátová">Bezdrátová</option>
          </select>
      </div>
      <div class="form-group">
        <label class="form-label">Kategorie</label>
        <select class="form-control" name="kategorie" required>
          <option value="">-- Vyber kategorii --</option>
          <option value="herní">Herní</option>
          <option value="ergonomická">Ergonomická</option>
          <option value="kancelářská">Kancelářská</option>
          <option value="cestovní">Cestovní</option>
          <option value="vertikální">Vertikální</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">Popis</label>
        <textarea class="form-control" name="description" placeholder="Stručný popis myši…" required></textarea>
      </div>
      <div class="form-group">
        <label class="form-label">Fotografie</label>
        <input class="form-control form-control-file" type="file" name="image" accept="image/*">
      </div>
      <button type="submit" class="btn btn-primary btn-full">Uložit myš</button>
    </form>
  </div>
</div>
</body>
</html>
