<h1>Upravit myš</h1>
<form action="/mysi/<%= mys._id %>?_method=PUT" method="POST" enctype="multipart/form-data">
  <input type="text" name="name" value="<%= mys.name %>" required>
  <br><br>
  <input type="text" name="breed" value="<%= mys.breed %>" required>
  <br><br>
  <input type="number" name="age" value="<%= mys.age %>" required>
  <br><br>
  <textarea name="description" required><%= mys.description %></textarea>
  <br><br>
  <input type="file" name="image">
  <br><br>
  <button type="submit">Uložit změny</button>
</form>
<p><a href="/mysi/<%= mys._id %>">Zpět</a></p>
